# Copy to .env.local and fill in values

# Solana RPC endpoint (public devnet by default)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Server-side RPC (for API routes building transactions)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Server secret for HMAC-signing listen session tokens (TODO: implement)
SESSION_SECRET=change-me-in-production-32-chars-minimum
