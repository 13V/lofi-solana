# ──────────────────────────────────────────────────────────────────────────
# lofi-solana — environment template. Copy to .env.local (web) / .env (server).
# Nothing secret should ever be committed; see .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── RPC / cluster ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Recommended for production (DAS + webhooks): Helius — see docs/research/solana-stack.md
# NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=

# ── Launch rail ────────────────────────────────────────────────────────────
# pumpfun = ride pump.fun (default) | meteora = our own branded bonding curve
NEXT_PUBLIC_LAUNCH_PROVIDER=pumpfun
PUMPPORTAL_API_KEY=

# ── On-chain rewards program ───────────────────────────────────────────────
NEXT_PUBLIC_REWARDS_PROGRAM_ID=Lof1Rewardsdistr1butor1111111111111111111111

# ── Proof-of-listen (SERVER ONLY) ──────────────────────────────────────────
# HMAC secret for signing listen-session tokens
LISTEN_SESSION_SECRET=dev-only-change-me
# Base58 secret key of the oracle that signs epoch Merkle roots posted on-chain
ORACLE_PRIVATE_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
# v1: Cloudflare R2 (cheap, $0 egress)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lofi-songs
# v2: permanent — Arweave via Irys
IRYS_PRIVATE_KEY=
